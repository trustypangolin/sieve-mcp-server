{
  "name": "sieve-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for managing Sieve mail filter scripts over ManageSieve (RFC 5804)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sieve-mcp-server": "dist/index.js",
    "sieve-mcp-setup": "dist/setup.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sieve",
    "managesieve",
    "email",
    "mail-filter",
    "claude"
  ],
  "author": "Benjamin Luton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustypangolin/sieve-mcp-server.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
